# ==============================================================================
# HTTPS 反向代理示例
# 适用于：Spring Boot / Node.js / Go 后端
# 使用方法：复制为 example.com.conf，替换 server_name、证书路径和 upstream
# ==============================================================================

# --------------------------------------------------------------------------
# 后端服务
# 推荐使用 docker compose 服务名，如 app:9080
# --------------------------------------------------------------------------
upstream app_backend {
    server app:9080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com;

    # --------------------------------------------------------------------------
    # 上传限制
    # --------------------------------------------------------------------------
    client_max_body_size 10m;

    # --------------------------------------------------------------------------
    # SSL
    # --------------------------------------------------------------------------
    ssl_certificate     /etc/nginx/ssl/example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/example.com.key;

    ssl_protocols TLSv1.2 TLSv1.3;

    ssl_ciphers
        ECDHE-ECDSA-AES128-GCM-SHA256:
        ECDHE-RSA-AES128-GCM-SHA256:
        ECDHE-ECDSA-AES256-GCM-SHA384:
        ECDHE-RSA-AES256-GCM-SHA384:
        ECDHE-ECDSA-CHACHA20-POLY1305:
        ECDHE-RSA-CHACHA20-POLY1305;

    ssl_prefer_server_ciphers off;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --------------------------------------------------------------------------
    # 安全 Header（HSTS 仅 HTTPS 站点启用，其余已在 nginx.conf 全局配置）
    # --------------------------------------------------------------------------
    add_header Strict-Transport-Security "max-age=31536000" always;

    # --------------------------------------------------------------------------
    # 日志
    # --------------------------------------------------------------------------
    access_log /var/log/nginx/example.com.access.log main buffer=32k flush=5s;
    error_log /var/log/nginx/example.com.error.log warn;

    # --------------------------------------------------------------------------
    # 禁止访问隐藏文件和敏感文件
    # --------------------------------------------------------------------------
    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~ \.(sql|bak|sh|conf|tpl)$ {
        deny all;
    }

    # --------------------------------------------------------------------------
    # 反向代理
    # --------------------------------------------------------------------------
    location / {

        proxy_pass http://app_backend;

        # WebSocket 支持（map $http_upgrade $connection_upgrade 定义在 nginx.conf）
        # 非 WebSocket 请求时 Connection: close，避免与 keepalive 冲突
        # 如需 keepalive + WebSocket，可改用条件判断（见下方注释）
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Timeout
        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;

        # Buffer（WebSocket/SSE 场景可改为 off）
        proxy_buffering on;
        proxy_buffers 16 16k;
        proxy_buffer_size 16k;
    }

    # --------------------------------------------------------------------------
    # WebSocket 专用路径（可选 - 需要 keepalive 时使用）
    # --------------------------------------------------------------------------
    # location /ws {
    #     proxy_pass http://app_backend;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade    $http_upgrade;
    #     proxy_set_header Connection "upgrade";
    #     proxy_read_timeout 3600s;
    # }
}
