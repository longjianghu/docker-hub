# ==============================================================================
# HTTPS 反向代理示例
# 适用于：Spring Boot / Node.js / Go 后端
# 使用方法：复制为 example.com.conf，替换 server_name、证书路径和 upstream
# ==============================================================================

# --------------------------------------------------------------------------
# 后端服务
# 推荐使用 docker compose 服务名，如 app:9080
# --------------------------------------------------------------------------
upstream app_backend {
    server app:9080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com;

    # --------------------------------------------------------------------------
    # 上传限制
    # --------------------------------------------------------------------------
    client_max_body_size 10m;

    # --------------------------------------------------------------------------
    # SSL
    # --------------------------------------------------------------------------
    ssl_certificate     /etc/nginx/ssl/example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/example.com.key;

    ssl_protocols TLSv1.2 TLSv1.3;

    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';

    ssl_prefer_server_ciphers off;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --------------------------------------------------------------------------
    # 安全 Header（HSTS 仅 HTTPS 站点启用，其余已在 nginx.conf 全局配置）
    # --------------------------------------------------------------------------
    add_header Strict-Transport-Security "max-age=31536000" always;

    # --------------------------------------------------------------------------
    # 日志
    # --------------------------------------------------------------------------
    access_log /var/log/nginx/example.com.access.log main buffer=32k flush=5s;
    error_log /var/log/nginx/example.com.error.log warn;

    # --------------------------------------------------------------------------
    # 禁止访问隐藏文件和敏感文件
    # --------------------------------------------------------------------------
    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~ \.(sql|bak|sh|conf|tpl)$ {
        deny all;
    }

    # --------------------------------------------------------------------------
    # HTTP API 反向代理（保持缓冲，优化性能）
    # --------------------------------------------------------------------------
    location / {
        proxy_pass http://app_backend;

        # Header 透传（全局已在 nginx.conf 配置，此处显式列出供参考）
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout
        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;

        # Buffer（HTTP API 保持开启，优化性能）
        proxy_buffering on;
        proxy_buffers 16 16k;
        proxy_buffer_size 16k;
    }

    # --------------------------------------------------------------------------
    # WebSocket 专用路径（关闭缓冲，实现实时传输）
    # 注意：需要在 nginx.conf 中定义 map $http_upgrade $connection_upgrade
    # --------------------------------------------------------------------------
    location /ws {
        proxy_pass http://app_backend;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 长连接超时（WebSocket 需要更长超时）
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Buffer（WebSocket 必须关闭缓冲）
        proxy_buffering off;
    }
}
